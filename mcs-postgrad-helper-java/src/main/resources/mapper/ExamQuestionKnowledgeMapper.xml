<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mcs.mapper.ExamQuestionKnowledgeMapper">

    <select id="selectKbIdsByQuestionId" resultType="java.lang.String">
        SELECT knowledge_block_id
        FROM exam_question_knowledge
        WHERE question_id = #{questionId}
    </select>

</mapper>

